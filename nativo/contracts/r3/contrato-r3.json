      },
      {
        "type": "table",
        "name": "folder_scopes",
        "tabla": "folder_scopes",
        "sql": "CREATE TABLE folder_scopes ( scope_id TEXT PRIMARY KEY, root TEXT NOT NULL, authorization_generation TEXT, generation INTEGER NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, issues_json TEXT NOT NULL DEFAULT '[]', revision TEXT NOT NULL DEFAULT '' )"
      },
      {
        "type": "table",
        "name": "scanned_files",
