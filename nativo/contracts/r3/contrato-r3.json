        "sql": "CREATE TABLE scanned_files ( scope_id TEXT NOT NULL, relative_path TEXT NOT NULL, fingerprint TEXT NOT NULL, scanned_at TEXT NOT NULL, PRIMARY KEY (scope_id, relative_path) )"
